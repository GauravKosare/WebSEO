# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Google AI Studio free-tier key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google Cloud API key with PageSpeed Insights API enabled (free quota): https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY=

# Random long secret used to authenticate the /api/cron/rescan endpoint.
# Vercel automatically sends this as "Authorization: Bearer <value>" for cron
# invocations when a project env var is named exactly CRON_SECRET.
CRON_SECRET=

# Optional: enables "Email report" on the results page. Free tier at
# https://resend.com/api-keys — no domain verification needed to start,
# resend.dev's shared sending address works out of the box. Without this set,
# the button still shows but reports a clear "not configured" error instead
# of failing silently.
RESEND_API_KEY=

# Optional: custom "from" address once you verify your own domain with
# Resend, e.g. "WebSEO <reports@yourdomain.com>". Falls back to
# "WebSEO <onboarding@resend.dev>" (Resend's shared testing address) if unset.
RESEND_FROM_EMAIL=
