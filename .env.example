# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Google AI Studio free-tier key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Google Cloud API key with PageSpeed Insights API enabled (free quota): https://developers.google.com/speed/docs/insights/v5/get-started
# Also reused for the Safe Browsing malware/phishing check below — enable
# "Safe Browsing API" on the same Google Cloud project, no separate key needed.
PAGESPEED_API_KEY=

# Free key from https://www.domcop.com/openpagerank/auth/signup — powers the
# Domain Authority (0-10) metric, computed from Common Crawl's open web graph.
# Free tier: 30,000 domain lookups/month.
OPENPAGERANK_API_KEY=

# Random long secret used to authenticate the /api/cron/rescan endpoint.
# Vercel automatically sends this as "Authorization: Bearer <value>" for cron
# invocations when a project env var is named exactly CRON_SECRET.
CRON_SECRET=

# Optional: enables "Email report" on the results page. Free tier (300
# emails/day) at https://app.brevo.com/settings/keys/api.
BREVO_API_KEY=

# Required alongside BREVO_API_KEY. Brevo requires the sender address to be
# verified in your account first — add it under Settings > Senders, Domains
# & Dedicated IPs > Senders, verify it, then set it here as either
# "WebSEO <reports@yourdomain.com>" or just "reports@yourdomain.com".
BREVO_FROM_EMAIL=
